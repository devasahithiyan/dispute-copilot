# Copy this file to .env.local and fill in your values.

# PayPal sandbox app keys: developer.paypal.com > Apps & Credentials > (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID; the browser uses it to show the PayPal button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Groq API key for the AI agent: console.groq.com/keys (used from Day 2)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
